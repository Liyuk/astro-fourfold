# Origin only. Do not include a repository subpath here.
# This repository's live demo:
#   SITE_URL=https://liyuk.github.io
#   BASE_PATH=/astro-fourfold
#   → https://liyuk.github.io/astro-fourfold/
#
# User site or custom domain (site is served from the domain root):
#   SITE_URL=https://example.com
#   BASE_PATH=/
SITE_URL=https://OWNER.github.io

# Repository subpath. Use /REPOSITORY-NAME for a GitHub Pages project site, or / otherwise.
BASE_PATH=/REPOSITORY-NAME
