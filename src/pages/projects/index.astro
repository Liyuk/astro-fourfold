---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byDate, getPublishedCollection, projectPath } from '../../lib/content';
const projects=byDate(await getPublishedCollection('projects'));
---
<BaseLayout title="项目 · Fourfold" description="产品、工具、实验与其他长期项目。"><header class="page-head container"><p class="eyebrow">Projects</p><h1>做过什么，正在做什么。</h1></header><section class="container list">{projects.map((entry)=><article class="project"><div><p class="eyebrow">{entry.data.status} · {entry.data.type}</p><h2><a href={projectPath(entry)}>{entry.data.title}</a></h2></div><p>{entry.data.description}</p></article>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;max-width:50rem;margin:.5rem 0}.project{display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:1.5rem 0;border-top:1px solid var(--line)}.project h2{margin:.3rem 0;font-size:1.7rem}.project p:last-child{color:var(--muted);margin:0}@media(max-width:42rem){.project{grid-template-columns:1fr;gap:.2rem}}</style>
