---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TagList from '../../../../components/blog/TagList.astro';
import Icon from '../../../../components/chrome/Icon.astro';
import { getPublishedCollection } from '../../../../lib/content';
export async function getStaticPaths(){ const entries=await getPublishedCollection('research'); return entries.map((entry)=>{const d=entry.data.publishedAt;return {params:{year:String(d.getFullYear()),month:String(d.getMonth()+1).padStart(2,'0'),slug:entry.id.replace(/^.*\//,'').replace(/\.(md|mdx)$/,'')},props:{entry}}}); }
const {entry}=Astro.props; const {Content}=await render(entry);
---
<BaseLayout title={`${entry.data.title} · Fourfold`} description={entry.data.description} canonical={entry.data.canonical} image={entry.data.ogImage}><article class="article narrow"><p class="eyebrow">{entry.data.kind} · v{entry.data.version}</p><h1>{entry.data.title}</h1><p class="dek">{entry.data.description}</p><TagList tags={entry.data.tags}/><div class="prose"><Content/></div>{(entry.data.paperUrl||entry.data.codeUrl)&&<p class="outlinks">{entry.data.paperUrl&&<a href={entry.data.paperUrl} rel="noopener noreferrer">论文 <Icon name="arrowUpRight" size="sm" /></a>}{entry.data.codeUrl&&<a href={entry.data.codeUrl} rel="noopener noreferrer">代码 <Icon name="arrowUpRight" size="sm" /></a>}</p>}</article></BaseLayout>
<style>.article{padding:5rem 0}.article h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.dek{font-size:1.3rem;color:var(--muted)}.outlinks{display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:2rem}.outlinks a{color:var(--accent)}</style>
