---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byDate, getPublishedCollection, researchPath } from '../../lib/content';
const entries=byDate(await getPublishedCollection('research'));
---
<BaseLayout title="研究 · Fourfold" description="研究笔记、预印本和可复用的思考工具。"><header class="page-head container"><p class="eyebrow">Research</p><h1>把问题写到可以被检验。</h1></header><section class="container list">{entries.map((entry)=><article class="research"><div><p class="eyebrow">{entry.data.kind} · v{entry.data.version} · {entry.data.publishedAt.getFullYear()}</p><h2><a href={researchPath(entry)}>{entry.data.title}</a></h2></div><p>{entry.data.description}</p></article>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;max-width:55rem;margin:.5rem 0}.research{display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:1.5rem 0;border-top:1px solid var(--line)}.research h2{margin:.3rem 0;font-size:1.6rem}.research p:last-child{color:var(--muted);margin:0}@media(max-width:42rem){.research{grid-template-columns:1fr;gap:.2rem}}</style>
