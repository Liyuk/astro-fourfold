---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/chrome/Icon.astro';
import { getPublishedCollection } from '../lib/content';
const links=(await getPublishedCollection('links')).sort((a,b)=>a.data.order-b.data.order||a.data.title.localeCompare(b.data.title,'zh')); const groups=[...new Set(links.map((item)=>item.data.group))];
---
<BaseLayout title="友链 · Fourfold"><header class="page-head container"><p class="eyebrow">Links</p><h1>我常读的站点。</h1><p>人工精选，优先收录持续写作和认真维护的独立站点。</p></header><section class="container">{groups.map((group)=><div class="group"><h2>{group}</h2>{links.filter((item)=>item.data.group===group).map((item)=><a class="link" href={item.data.url} rel="nofollow noopener"><span>{item.data.title}</span><small>{item.data.description}</small><b><Icon name="arrowUpRight" size="sm" /></b></a>)}</div>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}.group{margin-bottom:3rem}.group h2{font-size:1rem;color:var(--muted);font-weight:400}.link{display:grid;grid-template-columns:1fr 2fr auto;gap:1rem;align-items:center;padding:1rem 0;border-top:1px solid var(--line);text-decoration:none}.link small{color:var(--muted)}.link b{color:var(--accent)}@media(max-width:42rem){.link{grid-template-columns:1fr auto}.link small{grid-column:1/2;grid-row:2}}</style>
