---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedCollection, photoPath } from '../../lib/content';
import { assetPath } from '../../lib/urls';
import Icon from '../../components/chrome/Icon.astro';
const entries=(await getPublishedCollection('photos')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="影像 · Fourfold" description="精选影像与现场笔记。"><header class="page-head container"><p class="eyebrow">Photos</p><h1>一些现场。</h1><p>精选系列，而不是无限流。</p></header><section class="container galleries">{entries.map((entry)=><a href={photoPath(entry)}><div class="cover">{entry.data.cover ? <img src={assetPath(entry.data.cover)} alt={entry.data.title} /> : <span><Icon name="close" size="lg" /></span>}</div><h2>{entry.data.title}</h2><p>{entry.data.description}</p><small>{entry.data.photos.length} 张</small></a>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}.galleries{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem}.galleries a{text-decoration:none}.cover{aspect-ratio:1.6;background:var(--soft);overflow:hidden}.cover img{width:100%;height:100%;object-fit:cover}.cover span{display:grid;place-items:center;height:100%;font-size:4rem;color:var(--accent)}.galleries h2{margin:.7rem 0 .1rem;font-size:1.5rem}.galleries p{color:var(--muted);margin:0}.galleries small{color:var(--accent)}@media(max-width:42rem){.galleries{grid-template-columns:1fr}}</style>
