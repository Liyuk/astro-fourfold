---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assetPath } from '../../lib/urls';
export async function getStaticPaths(){ const {getCollection}=await import('astro:content'); const entries=await getCollection('photos',({data})=>!data.draft); return entries.map((entry)=>({params:{slug:entry.data.slug},props:{entry}})); }
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<BaseLayout title={`${entry.data.title} · Fourfold`} description={entry.data.description} canonical={entry.data.canonical} image={entry.data.ogImage ?? entry.data.cover}><header class="page-head container"><p class="eyebrow">Photo essay</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p></header><div class="narrow prose essay"><Content /></div><section class="container gallery">{entry.data.photos.map((photo)=><figure><img src={assetPath(photo.src)} alt={photo.alt}/>{photo.caption&&<figcaption>{photo.caption}</figcaption>}</figure>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 2rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}.essay{padding-bottom:1rem}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.gallery figure{margin:0}.gallery img{width:100%;display:block}.gallery figcaption{font-size:.8rem;color:var(--muted);padding:.5rem 0}@media(max-width:42rem){.gallery{grid-template-columns:1fr}}</style>
